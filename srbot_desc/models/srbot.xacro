  <!-- CAMERA LINK -->

  <link name="camera_1">
    <inertial>
      <origin xyz="0.12 0.0 -0.06" rpy="0 0 0" />
      <mass value="0.035324999999999995" />
      <inertia ixx="5e-06" iyy="3e-06" izz="3e-06" ixy="0.0" iyz="0.0" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.0 -0.0 -0.2" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://srbot_desc/meshes/camera_1.stl" scale="0.001 0.001 0.001" />
