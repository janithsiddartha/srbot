      <inertia ixx="1e-05" iyy="1.3e-05" izz="8e-06" ixy="-3e-06" iyz="-0.0" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.056 0.096995 -0.03" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://srbot_desc/meshes/right_wheel_1.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <!-- <material name="c"> -->
        <!-- <color rgba="0.0 1.0 0.0 1.0"/> Red color (R, G, B, Alpha) -->
      <!-- </material> -->
    </visual>
    <collision>
      <origin xyz="-0.056 0.096995 -0.03" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://srbot_desc/meshes/right_wheel_1.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <link name="back_wheel_1">
    <inertial>
      <origin xyz="0.00999961394615441 -7.67165219672053e-14 6.938893903907228e-18" rpy="0 0 0" />
      <mass value="0.03574123455429425" />
      <inertia ixx="1.5e-05" iyy="8e-06" izz="8e-06" ixy="-0.0" iyz="-0.0" ixz="-0.0" />
    </inertial>
    <visual>
      <origin xyz="0.112 -0.0 -0.03" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://srbot_desc/meshes/back_wheel_1.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <!-- <material name="d"> -->
        <!-- <color rgba="0.0 0.0 0.0 1.0"/> Red color (R, G, B, Alpha) -->
      <!-- </material> -->
    </visual>
    <collision>
      <origin xyz="0.112 -0.0 -0.03" rpy="0 0 0" />
