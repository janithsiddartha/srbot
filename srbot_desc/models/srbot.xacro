<?xml version="1.0"?>
<robot name="srbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- BASE LINKS -->

  <link name="base_footprint" />

  <link name="base_link">
    <inertial>
      <origin xyz="5.643506381932405e-16 3.255869066499464e-16 0.09526904860001788" rpy="0 0 0" />
      <mass value="0.8883014312204645" />
      <inertia ixx="0.005305" iyy="0.005305" izz="0.006488" ixy="0.0" iyz="0.0" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://srbot_desc/meshes/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <!-- <material name="a"> -->
        <!-- <color rgba="0.0 1.0 1.0 1.0"/> Red color (R, G, B, Alpha) -->
      <!-- </material> -->
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://srbot_desc/meshes/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <!-- WHEEL LINKS -->

  <link name="left_wheel_1">
    <inertial>
      <origin xyz="-0.004999806973077149 -0.008660074481549776 1.3877787807814457e-17" rpy="0 0 0" />
      <mass value="0.03574123455429439" />
      <inertia ixx="1e-05" iyy="1.3e-05" izz="8e-06" ixy="3e-06" iyz="-0.0" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.056 -0.096995 -0.03" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://srbot_desc/meshes/left_wheel_1.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <!-- <material name="b"> -->
        <!-- <color rgba="1.0 0.0 0.0 1.0"/> Red color (R, G, B, Alpha) -->
      <!-- </material> -->
    </visual>
    <collision>
      <origin xyz="-0.056 -0.096995 -0.03" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://srbot_desc/meshes/left_wheel_1.stl"
          scale="0.001 0.001 0.001" />
