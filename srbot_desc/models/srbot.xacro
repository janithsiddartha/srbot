  <!-- LIDAR LINK -->

  <link name="lidar_1">
    <inertial>
      <origin xyz="5.5476036134154956e-18 0.0 0.01056130335258168" rpy="0 0 0" />
      <mass value="0.1040017891764952" />
      <inertia ixx="4.8e-05" iyy="4.8e-05" izz="8.1e-05" ixy="0.0" iyz="0.0" ixz="-0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.0 -0.0 -0.16" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://srbot_desc/meshes/lidar_1.stl" scale="0.001 0.001 0.001" />
